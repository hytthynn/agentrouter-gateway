# === AgentRouter Gateway — пример окружения ===
# Скопируйте в .env (server/.env) и при необходимости отредактируйте.
# Все значения имеют безопасные дефолты — запускать можно без .env.

# --- Сеть ---
AGW_HOST=127.0.0.1
AGW_PORT=8787

# --- Каталог данных (БД, мастер-ключ, storage-state, логи) ---
# По умолчанию: <корень репозитория>/data
# AGW_DATA_DIR=./data

# --- Мастер-ключ шифрования (AES-256-GCM) ---
# По умолчанию: файл data/.master_key (создаётся автоматически, права 0600).
# Можно задать явно (base32/base64/hex или произвольная строка >= 32 байт):
# AGW_MASTER_KEY=

# --- Каталоги web/dist для статики UI (prod) ---
# По умолчанию: <корень репозитория>/web/dist
# AGW_WEB_DIST=../web/dist

# --- Дополнительные опции ---
# AGW_LOG_LEVEL=INFO
# AGW_DEFAULT_BASE_URL=https://agentrouter.org
